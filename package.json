{
  "name": "mdview",
  "version": "0.1.1",
  "description": "Terminal markdown pager, compiled to a self-contained binary with Bun",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "generate:folds": "bun run scripts/generate-case-folds.ts",
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
